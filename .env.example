# Copy to .env and fill in — or just run scripts/gen-secrets.sh, which creates
# .env with fresh random passwords and the matching Mosquitto password file.
#
# .env is gitignored and must stay chmod 600. Real passwords never go into git.

TZ=Europe/Moscow

# --- Mosquitto accounts (see MQTT.md for what each one may do) --------
HA_MQTT_USER=homeassistant
HA_MQTT_PASSWORD=

WEATHER_COLLECTOR_MQTT_USER=weather_collector
WEATHER_COLLECTOR_MQTT_PASSWORD=

RF_COLLECTOR_MQTT_USER=rf_collector
RF_COLLECTOR_MQTT_PASSWORD=

# Read-only account for the ESP32-S3 watches
WATCH_MQTT_USER=watch
WATCH_MQTT_PASSWORD=

WEATHER_ENGINE_MQTT_USER=weather_engine
WEATHER_ENGINE_MQTT_PASSWORD=

MESHCORE_MQTT_USER=meshcore
MESHCORE_MQTT_PASSWORD=

RTL433_MQTT_USER=rtl433
RTL433_MQTT_PASSWORD=

# Used by the container healthcheck and the round-trip test
MONITOR_MQTT_USER=monitor
MONITOR_MQTT_PASSWORD=

# --- LAN ---------------------------------------------------------------------
LAN_SUBNET=192.168.1.0/24
