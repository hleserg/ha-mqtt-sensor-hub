# Журнал задания коллектора: строка на каждый проход, 144 строки в сутки.
#
# Ротируется только ЭТОТ файл. Архив кадров в ~/.local/share/rtl433-node/
# сюда сознательно не включён: при нынешних 82 кадрах в сутки он растёт
# примерно на 44 МБ в год, а владелец прямо сказал не терять пойманное.
# Ротация с удалением старых поколений — это и есть потеря, только по
# расписанию и без свидетелей.
/home/sergey/iot-stack-rf433.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    su sergey sergey
    create 0644 sergey sergey
}
