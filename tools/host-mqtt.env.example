# host_mqtt.py — пример настроек. Linux: /etc/default/host-mqtt (chmod 600),
# macOS: ~/.config/host-mqtt.env, Windows: C:\ProgramData\host-mqtt\host-mqtt.env.
# Учётка: scripts/add-mqtt-user.sh <имя> (имя = MQTT_USER = sensor_id).
MQTT_HOST=192.168.1.51
MQTT_PORT=1883
MQTT_USER=myhost
MQTT_PASS=
INTERVAL_S=30
# что пишется в meta.board
BOARD=linux
# диск для disk_used_pct / disk_free_gb (macOS: /System/Volumes/Data, Windows: C:\)
DISK_PATH=/
# чипы hwmon для cpu_temperature, первый найденный
CPU_SENSORS=cpu_thermal,coretemp,k10temp
# только BetaPi: файл состояния UPS от x1202-guard
#X1202_STATE=/run/x1202-guard/state.json
#UPS_MAX_AGE_S=60
