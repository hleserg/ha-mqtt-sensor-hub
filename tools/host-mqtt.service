# /etc/systemd/system/host-mqtt.service — Linux-машины стека (tools/host_mqtt.py)
[Unit]
Description=Host metrics -> MQTT (own/<host>/...)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/host-mqtt
EnvironmentFile=/etc/default/host-mqtt
Restart=always
RestartSec=15
DynamicUser=yes

[Install]
WantedBy=multi-user.target
